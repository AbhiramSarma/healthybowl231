# API Configuration
# For production, set this to your Render backend URL (e.g., https://your-backend.onrender.com)
# Leave empty for development (uses Vite proxy)
VITE_API_URL=

# Socket.IO Configuration
# For production, set this to your Render backend URL
# For development, defaults to http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
