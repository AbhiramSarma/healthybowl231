# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local development: mongodb://127.0.0.1:27017/spice_route
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/spice_route?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spice_route

# JWT Configuration
# IMPORTANT: Use a strong secret key (minimum 32 characters) in production
# Example of a strong secret (128 characters - DO NOT use this exact one, generate your own):
# JWT_SECRET=bd3bc4c141449f9da27e432a59b16e5d94b09ae43e9058c6ecfa49d5fb5dd7076a46818a3959992242031d7da6c3bfa6b95d18bfe48f49d6f3c8c62953d14aeb
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Razorpay Configuration
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Configuration
# For development: http://localhost:5173,http://localhost:3000
# For production: https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Socket.IO Configuration
# For development: http://localhost:5000
# For production: https://your-backend-name.onrender.com
SOCKET_URL=http://localhost:5000
